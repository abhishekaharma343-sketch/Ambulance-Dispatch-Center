// ---------- FIT ANIMATED SCENE TO SCREEN ----------
function fitScene() {
  var sv = document.querySelector(".scene"), small = window.innerWidth < 700;
  sv.setAttribute("viewBox", small ? "250 0 750 150" : "0 0 1000 150");
  sv.setAttribute("preserveAspectRatio", small ? "xMidYMax meet" : "xMidYMax slice");
}
window.addEventListener("resize", fitScene);
fitScene();

// ---------- HEADER MENU ----------
function toggleMenu() {
  $("chips").classList.toggle("open");
  $("menubtn").classList.toggle("open");
}
document.addEventListener("click", function (e) {
  if (!$("hdrRight").contains(e.target)) { $("chips").classList.remove("open"); $("menubtn").classList.remove("open"); }
});

// ---------- DARK / LIGHT MODE ----------
function setTheme(t) {
  document.documentElement.setAttribute("data-theme", t);
  $("themebtn").textContent = t === "dark" ? "☀️" : "🌙";
  try { localStorage.setItem("asrTheme", t); } catch (e) {}
}
function toggleTheme() { setTheme(document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark"); }

