  "Choking":{t:"दम घुटना (गले में कुछ फंसना)",a:["व्यक्ति को ज़ोर से खांसने के लिए कहें।","यदि वे खांस, बोल या सांस न ले सकें, तो कंधों के बीच 5 ज़ोरदार थपकी दें।","फिर पेट पर 5 झटके दें (पीछे खड़े हों, नाभि के ऊपर मुट्ठी रखें, अंदर और ऊपर की ओर खींचें)।","वस्तु निकलने तक थपकी और झटके दोहराएं।","शिशु के लिए सिर्फ़ 5 पीठ पर थपकी और 5 छाती पर दबाव दें। बेहोश हो जाए तो सीपीआर शुरू करें।"]},
  "Severe bleeding":{t:"गंभीर रक्तस्राव",a:["साफ़ कपड़े या पट्टी से घाव को मज़बूती से दबाएं।","कपड़ा भीग जाए तो उसे न हटाएं; ऊपर से और कपड़ा लगाएं।","संभव हो तो घायल अंग को ऊपर उठाएं और व्यक्ति को लिटाए रखें।","घाव में फंसी वस्तु को न निकालें।","व्यक्ति को गर्म और शांत रखें।"]},
  "Burns":{t:"जलना",a:["जले हुए हिस्से को 20 मिनट तक ठंडे बहते पानी के नीचे रखें।","जले स्थान के पास की अंगूठी या तंग चीज़ें हटाएं, जब तक वे त्वचा से चिपकी न हों।","साफ़ क्लिंग फ़िल्म या बिना रोएं वाले कपड़े से ढीला ढक दें।","बर्फ, मक्खन या टूथपेस्ट न लगाएं और छाले न फोड़ें।","गंभीर या बड़े जलने पर अस्पताल ज़रूरी है।"]}
};
function tr(s) {
  if (LANG !== "hi" || !s) return s;
  var core = s.trim();
  if (HI[core]) return s.replace(core, HI[core]);
  var out = s;
  PARTS.forEach(function (p) { out = p[0] instanceof RegExp ? out.replace(p[0], p[1]) : out.split(p[0]).join(p[1]); });
  return out;
}
function trNode(n) {
  var v = n.nodeValue, p = n.parentNode;
  if (n._t === v || !v.trim() || !p || p.nodeName === "SCRIPT" || p.nodeName === "STYLE" || (p.closest && p.closest("[data-notr]"))) return;
  if (p.nodeName === "OPTION" && !p.hasAttribute("value")) p.setAttribute("value", v);
  var nv = tr(v);
  if (nv !== v) { n._o = v; n._t = nv; n.nodeValue = nv; }
}
function trAttrs(root) {
  [].forEach.call(root.querySelectorAll("[placeholder],[title]"), function (e) {
    ["placeholder", "title"].forEach(function (a) {
      if (!e.hasAttribute(a) || e.id === "langbtn") return;
      var k = "data-o-" + a;
      if (!e.hasAttribute(k)) e.setAttribute(k, e.getAttribute(a));
      e.setAttribute(a, LANG === "hi" ? tr(e.getAttribute(k)) : e.getAttribute(k));
    });
  });
}
function walk(root) {
  if (root.nodeType === 3) { trNode(root); return; }
  if (root.nodeType !== 1) return;
  var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT), n, list = [];
  while ((n = w.nextNode())) list.push(n);
  list.forEach(trNode); trAttrs(root);
}
function setLang(l) {
  LANG = l;
  try { localStorage.setItem("asrLang", l); } catch (e) {}
  document.documentElement.lang = l;
  if (l === "hi") walk(document.body);
  else {
    var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT), n, list = [];
    while ((n = w.nextNode())) list.push(n);
    list.forEach(function (x) { if (x._o !== undefined && x._t === x.nodeValue) { x.nodeValue = x._o; x._t = undefined; } });
    trAttrs(document.body);
  }
  $("langbtn").textContent = l === "hi" ? "English" : "हिन्दी";
}
function toggleLang() { setLang(LANG === "hi" ? "en" : "hi"); }
new MutationObserver(function (ms) {
  if (LANG !== "hi") return;
  ms.forEach(function (m) {
    if (m.type === "characterData") trNode(m.target);
    else [].forEach.call(m.addedNodes, walk);
  });
}).observe(document.body, { childList: true, characterData: true, subtree: true });

