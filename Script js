<script>
// ---------- DATA ----------
var ZONES = { "Central Market":[2,3], "Railway Station":[4,7], "Airport Road":[9,2], "University Campus":[7,8],
  "Industrial Area":[10,6], "Riverside":[1,8], "Old Town":[3,1], "City Hospital":[5,5] };
var HOSPITAL = "City Hospital";
var PRIO_ORDER = { Critical:0, High:1, Medium:2, Low:3 };
var STEPS = ["Dispatched","En Route","On Scene","Transporting","At Hospital"];
var TABS = [ ["request","New Request"], ["dispatch","Dispatch"], ["active","Active Trips"], ["fleet","Fleet & Map"], ["history","History"] ];
var state = { requests: [], ambulances: [], nextId: 1 };
var tab = "request", prio = "Medium";

function defaultFleet() { return [
  {id:"AMB-01",driver:"Anil Sharma",zone:"Central Market",status:"Available"},
  {id:"AMB-02",driver:"Pooja Singh",zone:"Railway Station",status:"Available"},
  {id:"AMB-03",driver:"Rahul Verma",zone:"Airport Road",status:"Available"},
  {id:"AMB-04",driver:"Sunita Devi",zone:"University Campus",status:"Available"},
  {id:"AMB-05",driver:"Imran Khan",zone:"Industrial Area",status:"Out of Service"},
  {id:"AMB-06",driver:"Kiran Patel",zone:"City Hospital",status:"Available"} ]; }

function save() { try { localStorage.setItem("dispatchPro", JSON.stringify(state)); } catch (e) {} }
function load() {
  try { var s = localStorage.getItem("dispatchPro"); if (s) { state = JSON.parse(s); return; } } catch (e) {}
  state.ambulances = defaultFleet();
}

// ---------- HELPERS ----------
function $(id) { return document.getElementById(id); }
function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
function cls(s) { return s.replace(/ /g, "-"); }
function time(ts) { return new Date(ts).toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"}); }
function dist(a, b) { var p = ZONES[a], q = ZONES[b]; return Math.hypot(p[0]-q[0], p[1]-q[1]); }
function eta(d) { return Math.max(2, Math.round(d * 2.5)) + " min"; }
function req(id) { return state.requests.filter(function (r) { return r.id === id; })[0]; }
function amb(id) { return state.ambulances.filter(function (a) { return a.id === id; })[0]; }
function freeAmbs() { return state.ambulances.filter(function (a) { return a.status === "Available"; }); }
function nearest(zone) { return freeAmbs().sort(function (a, b) { return dist(a.zone, zone) - dist(b.zone, zone); })[0]; }
function pending() {
  return state.requests.filter(function (r) { return r.status === "Pending"; })
    .sort(function (a, b) { return PRIO_ORDER[a.priority] - PRIO_ORDER[b.priority] || a.time - b.time; });
}
function toast(msg) { var t = $("toast"); t.textContent = msg; t.className = "on"; setTimeout(function () { t.className = ""; }, 2600); }
function go(t) { tab = t; render(); }

// ---------- ACTIONS ----------
function makeRequest(name, desc, zone, priority) {
  state.requests.push({
    id: state.nextId++, name: name, desc: desc, zone: zone, priority: priority,
    time: Date.now(), status: "Pending", ambId: null, trip: null, end: null, outcome: ""
  });
}
function addRequest() {
  var n = $("name").value.trim(), d = $("desc").value.trim();
  if (!n || !d) { toast("⚠️ Enter patient name and description"); return; }
  makeRequest(n, d, $("zone").value, prio);
  $("name").value = ""; $("desc").value = "";
  toast("✅ Request submitted"); go("dispatch");
}
function simulate() {
  var names = ["Meena Rao","Ajay Gupta","Farah Ali","Deepak Jha","Sita Kumari","Vikram Das"];
  var descs = ["Road accident - injuries","Severe chest pain","Fall from height","Breathing difficulty","Burn injury","Unconscious, high fever"];
  var zones = Object.keys(ZONES).filter(function (z) { return z !== HOSPITAL; });
  var pr = ["Critical","High","Medium","Low"];
  for (var i = 0; i < 3; i++) {
    var r = Math.floor(Math.random() * names.length);
    makeRequest(names[r], descs[r], zones[Math.floor(Math.random()*zones.length)], pr[Math.floor(Math.random()*4)]);
  }
  toast("🚨 3 new requests arrived!"); go("dispatch");
}
function doAssign(rid, aid) {
  var r = req(rid), a = amb(aid);
  if (!r || !a || a.status !== "Available") return false;
  r.status = "Active"; r.ambId = aid; r.trip = "Dispatched"; a.status = "Dispatched";
  return true;
}
function dispatch(rid) {
  var s = $("sel-" + rid);
  if (!s || !s.value) { toast("❌ No ambulance available"); return; }
  doAssign(rid, s.value); toast("🚑 Ambulance dispatched"); render();
}
function autoAssign() {
  var c = 0;
  pending().forEach(function (r) { var a = nearest(r.zone); if (a && doAssign(r.id, a.id)) c++; });
  toast(c ? "⚡ " + c + " ambulance(s) auto-assigned" : "❌ Nothing to assign"); render();
}
function cancelReq(id) { var r = req(id); r.status = "Done"; r.outcome = "Cancelled"; r.end = Date.now(); render(); }
function advance(id) {
  var r = req(id), a = amb(r.ambId), i = STEPS.indexOf(r.trip);
  if (i < STEPS.length - 1) {
    r.trip = STEPS[i + 1]; a.status = r.trip;
    if (r.trip === "On Scene") a.zone = r.zone;
    if (r.trip === "At Hospital") a.zone = HOSPITAL;
  } else {
    r.status = "Done"; r.outcome = "Patient delivered"; r.end = Date.now();
    a.status = "Available"; a.zone = HOSPITAL; toast("✅ Trip completed");
  }
  render();
}
function toggleService(id) { var a = amb(id); a.status = a.status === "Available" ? "Out of Service" : "Available"; render(); }
function resetAll() {
  if (!confirm(tr("Delete all data and reset the fleet?"))) return;
  state = { requests: [], ambulances: defaultFleet(), nextId: 1 }; render();
}
function setPrio(p) { prio = p; renderPrio(); }

// ---------- RENDER ----------
function renderPrio() {
  $("prio").innerHTML = ["Critical","High","Medium","Low"].map(function (p) {
    return '<div class="' + p + (p === prio ? " sel" : "") + '" onclick="setPrio(\'' + p + '\')">' + p + "</div>";
  }).join("");
}

function renderMap() {
  var S = 40, svg = '';
  for (var i = 0; i <= 12; i++) svg += '<line x1="' + i*S + '" y1="0" x2="' + i*S + '" y2="400" stroke="currentColor" stroke-opacity=".18"/>';
  for (var j = 0; j <= 10; j++) svg += '<line x1="0" y1="' + j*S + '" x2="480" y2="' + j*S + '" stroke="currentColor" stroke-opacity=".18"/>';
  var pend = {}; state.requests.forEach(function (r) { if (r.status !== "Done") pend[r.zone] = true; });
  Object.keys(ZONES).forEach(function (z) {
    var x = ZONES[z][0]*S + 20, y = ZONES[z][1]*S + 5, h = z === HOSPITAL;
    if (pend[z]) svg += '<circle class="pulse" cx="' + x + '" cy="' + y + '" r="8" fill="#ef4444"/>';
    svg += '<circle cx="' + x + '" cy="' + y + '" r="6" fill="' + (h ? '#14b8a6' : '#0ea5e9') + '"/>';
    svg += '<text x="' + x + '" y="' + (y + 20) + '" fill="currentColor" font-size="10" text-anchor="middle">' + (h ? "🏥 " : "") + z + '</text>';
  });
  var seen = {};
  state.ambulances.forEach(function (a) {
    seen[a.zone] = (seen[a.zone] || 0) + 1;
    var x = ZONES[a.zone][0]*S + 20 + (seen[a.zone]-1)*16 - 6, y = ZONES[a.zone][1]*S - 8;
    svg += '<text x="' + x + '" y="' + y + '" font-size="16" opacity="' + (a.status === "Out of Service" ? .35 : 1) + '">🚑</text>';
  });
  $("map").innerHTML = svg;
}

function render() {
  // chips + tabs
  var p = pending(), act = state.requests.filter(function (r) { return r.status === "Active"; });
  $("menubtn").setAttribute("data-n", p.length);
  $("chips").innerHTML = '<span class="chip">⏳ Pending <b>' + p.length + '</b></span><span class="chip">📡 Active <b>' + act.length +
    '</b></span><span class="chip">🟢 Free <b>' + freeAmbs().length + "/" + state.ambulances.length + "</b></span>";
  var counts = { dispatch: p.length, active: act.length };
  $("tabs").innerHTML = TABS.map(function (t) {
    var n = counts[t[0]] ? '<span class="n">' + counts[t[0]] + "</span>" : "";
    return '<button class="tab' + (t[0] === tab ? " active" : "") + '" onclick="go(\'' + t[0] + '\')">' + t[1] + n + "</button>";
  }).join("");
  TABS.forEach(function (t) { $("p-" + t[0]).className = "panel" + (t[0] === tab ? " show" : ""); });

  // pending cards
  $("pending").innerHTML = p.length ? p.map(function (r) {
    var list = freeAmbs().sort(function (a, b) { return dist(a.zone, r.zone) - dist(b.zone, r.zone); });
    var opts = list.length ? list.map(function (a, i) {
      var d = dist(a.zone, r.zone);
      return '<option value="' + a.id + '">' + a.id + " • " + d.toFixed(1) + " km • ETA " + eta(d) + (i === 0 ? " ★" : "") + "</option>";
    }).join("") : '<option value="">No ambulance free</option>';
    return '<div class="card ' + r.priority + '"><div class="info"><b>' + esc(r.name) + ' <span class="badge ' + r.priority + '">' + r.priority +
      "</span></b><div>" + esc(r.desc) + "</div><div>📍 " + r.zone + " &nbsp;•&nbsp; 🕒 " + time(r.time) + " &nbsp;•&nbsp; #" + r.id + "</div></div>" +
      '<div class="act"><select id="sel-' + r.id + '">' + opts + '</select><button class="btn sm ok" onclick="dispatch(' + r.id +
      ')">🚑 Dispatch</button><button class="btn sm no" onclick="cancelReq(' + r.id + ')">✖</button></div></div>';
  }).join("") : '<div class="empty">✅ No pending requests. All clear!</div>';

  // active cards
  $("active").innerHTML = act.length ? act.map(function (r) {
    var i = STEPS.indexOf(r.trip);
    var bar = STEPS.map(function (s, k) { return '<i class="' + (k <= i ? "done" : "") + '"></i>'; }).join("");
    var label = i === STEPS.length - 1 ? "✔ Complete Trip" : "Next ➜ " + STEPS[i + 1];
    return '<div class="card ' + r.priority + '"><div class="info"><b>' + esc(r.name) + ' <span class="badge ' + r.priority + '">' + r.priority +
      "</span></b><div>" + esc(r.desc) + "</div><div>📍 " + r.zone + " &nbsp;•&nbsp; 🚑 " + r.ambId + '</div></div><div class="act"><span class="badge s-' +
      cls(r.trip) + '">' + r.trip + '</span><button class="btn sm ok" onclick="advance(' + r.id + ')">' + label + '</button></div><div class="steps">' + bar + "</div></div>";
  }).join("") : '<div class="empty">No active trips right now.</div>';

  // fleet
  $("fleet").innerHTML = state.ambulances.map(function (a) {
    var b = a.status === "Available" ? '<button class="btn sm ghost" onclick="toggleService(\'' + a.id + '\')">Set Out of Service</button>'
      : a.status === "Out of Service" ? '<button class="btn sm ok" onclick="toggleService(\'' + a.id + '\')">Set Available</button>'
      : '<small>On a trip</small>';
    return '<div class="amb"><div class="e">🚑</div><b>' + a.id + "</b><small>" + esc(a.driver) + " • " + a.zone +
      '</small><span class="badge s-' + cls(a.status) + '">' + a.status + "</span><div style='margin-top:8px'>" + b + "</div></div>";
  }).join("");
  renderMap();

  // history
  var h = state.requests.filter(function (r) { return r.status === "Done"; }).sort(function (a, b) { return b.end - a.end; });
  $("history").innerHTML = h.length ? "<table><tr><th>#</th><th>Time</th><th>Patient</th><th>Description</th><th>Location</th><th>Priority</th><th>Ambulance</th><th>Outcome</th><th>Duration</th></tr>" +
    h.map(function (r) {
      return "<tr><td>" + r.id + "</td><td>" + time(r.time) + "</td><td>" + esc(r.name) + "</td><td>" + esc(r.desc) + "</td><td>" + r.zone +
        '</td><td><span class="badge ' + r.priority + '">' + r.priority + "</span></td><td>" + (r.ambId || "-") + "</td><td>" + r.outcome +
        "</td><td>" + Math.max(0, Math.round((r.end - r.time)/60000)) + " min</td></tr>";
    }).join("") + "</table>" : '<div class="empty">No completed incidents yet.</div>';

  save();
}

// ---------- TEAM TOGGLE ----------
function toggleTeam() {
  var open = $("team").classList.toggle("open");
  $("teambtn").textContent = open ? "🙈 Hide Team" : "👥 Meet the Team";
}

// ---------- AI FIRST-AID ASSISTANT (built-in, works offline) ----------
var AI_KB = [
  { t:"CPR (person not breathing / no pulse)", k:["cpr","not breathing","no pulse","cardiac arrest","stopped breathing","unresponsive","heart stopped"],
    a:["Check if the person responds and is breathing normally.","Push hard and fast in the centre of the chest, about 100-120 pushes per minute, 5-6 cm deep.","Let the chest rise fully between pushes. If untrained, do hands-only CPR.","If an AED is nearby, switch it on and follow its voice instructions.","Do not stop until the ambulance team takes over."] },
  { t:"Chest pain / possible heart attack", k:["chest pain","heart attack","chest tight","chest pressure","left arm"],
    a:["Make the person sit down, rest and stay calm.","Loosen tight clothing.","Do not give food or drink. The emergency operator may advise aspirin.","Stay with them and watch their breathing.","If they collapse and stop breathing, start CPR."] },
  { t:"Choking", k:["chok","stuck in throat","something stuck"],
    a:["Ask the person to cough hard if they can.","If they cannot cough, speak or breathe: give 5 firm back blows between the shoulder blades.","Then give 5 abdominal thrusts (stand behind, fist above the navel, pull inward and upward).","Repeat back blows and thrusts until the object comes out.","For a baby, use 5 back blows and 5 chest thrusts only. If the person becomes unconscious, start CPR."] },
  { t:"Severe bleeding", k:["bleed","blood","wound","stab","gunshot","deep cut"],
    a:["Press firmly on the wound with a clean cloth or bandage.","Do not remove the cloth if it soaks through; add more on top.","Raise the injured limb if possible and keep the person lying down.","Do not remove objects stuck in the wound.","Keep the person warm and calm."] },
  { t:"Burns", k:["burn","scald","boiling","hot water"],
    a:["Cool the burn under cool running water for 20 minutes.","Remove rings or tight items near the burn, unless stuck to the skin.","Cover loosely with clean cling film or a non-fluffy cloth.","Do not use ice, butter, toothpaste or burst blisters.","Serious or large burns need hospital care."] },
  { t:"Broken bone / fracture", k:["fractur","broken bone","bone","sprain","dislocat","fell","fall"],
    a:["Keep the person still and support the injured part in the position found.","Do not try to straighten the limb.","Apply a wrapped ice pack to reduce swelling.","If you suspect a neck or back injury, do not move the person at all.","Stay with them until help arrives."] },
  { t:"Road accident", k:["accident","crash","collision","road"],
    a:["Make sure the area is safe before approaching.","Do not move the injured unless there is danger such as fire.","Check breathing and control any heavy bleeding with firm pressure.","Keep the person still and warm. Do not remove a helmet unless breathing is blocked.","Tell the ambulance team what happened as soon as they arrive."] },
  { t:"Stroke (use FAST)", k:["stroke","face droop","slurred","speech","paralys","numb"],
    a:["Face: is one side drooping? Arms: can they raise both? Speech: is it slurred?","Time: note when symptoms started and tell the ambulance team.","Keep the person sitting or lying comfortably.","Do not give food, drink or medicine.","Stay with them and keep checking their breathing."] },
  { t:"Seizure / fits", k:["seizure","fits","convuls","epilep"],
    a:["Clear the area and cushion the head.","Do not hold the person down or put anything in their mouth.","Note how long the seizure lasts.","When the shaking stops, turn them onto their side (recovery position).","Call for urgent help if it lasts over 5 minutes or they do not wake up."] },
  { t:"Unconscious or fainted person", k:["unconscious","faint","passed out","collapse","not responding"],
    a:["Tap their shoulders and speak loudly. Check for normal breathing.","If breathing: place them on their side (recovery position) and keep the airway open.","If NOT breathing: start CPR.","If they are just fainting and wake up, lay them flat and raise the legs.","Do not give food or drink until fully alert."] },
  { t:"Severe allergic reaction", k:["allerg","anaphyla","swelling","sting","hives"],
    a:["If the person has an adrenaline (epinephrine) auto-injector, help them use it right away.","Remove the trigger if you can (for example a bee sting).","Lay them down with legs raised. If breathing is hard, let them sit up.","Stay with them and be ready to start CPR.","They still need hospital care even if they improve."] },
  { t:"Breathing difficulty / asthma", k:["asthma","wheez","breathless","short of breath","breathing difficulty","difficulty breathing","cant breathe","can't breathe"],
    a:["Help the person sit upright and stay calm.","Help them use their reliever inhaler as prescribed.","Loosen tight clothing and open a window for fresh air.","If they get worse, turn blue or cannot speak, tell the operator immediately.","If they stop breathing, start CPR."] },
  { t:"Snake or scorpion bite", k:["snake","scorpion"],
    a:["Keep the person calm and as still as possible.","Keep the bitten limb still and slightly below heart level; remove rings and watches.","Do NOT cut, suck, tie a tight tourniquet or apply ice.","Note the snake's appearance if it is safe to do so.","Get to hospital urgently for anti-venom."] },
  { t:"Animal bite (dog / monkey)", k:["dog","monkey","animal","rabies","bite"],
    a:["Wash the wound with soap and running water for at least 15 minutes.","Cover with a clean dressing.","Do not stitch or apply chilli, oil or herbs.","Go to hospital the same day for rabies vaccination."] },
  { t:"Poisoning", k:["poison","swallowed","overdose","chemical","pesticide"],
    a:["Do not make the person vomit.","Keep the container or label to show the medical team.","If poison is on skin or in the eyes, rinse with plenty of water.","Keep them awake and on their side if drowsy.","Tell the ambulance team what was taken and when."] },
  { t:"Drowning", k:["drown","swim"],
    a:["Pull the person out safely without putting yourself at risk.","If not breathing, start CPR. Rescue breaths matter for drowning if you can give them.","If breathing, place them on their side and keep them warm.","Everyone who nearly drowned needs hospital checks."] },
  { t:"Heatstroke", k:["heatstroke","heat stroke","sunstroke","heat","dehydrat"],
    a:["Move the person to shade or a cool place.","Cool the body with wet cloths, water or fanning.","If fully awake, give small sips of water.","Loosen or remove extra clothing.","Heatstroke is an emergency, so keep monitoring until help arrives."] },
  { t:"Electric shock", k:["electric","shock","current","live wire"],
    a:["Do NOT touch the person until the power is switched off.","Turn off the main switch, or push the source away with a dry wooden stick.","Check breathing and start CPR if needed.","Cover burns loosely with a clean cloth.","Every electric shock victim should be checked at hospital."] },
  { t:"Head injury", k:["head injury","head","concussion","skull"],
