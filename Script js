  { t:"Pregnancy / labour", k:["pregnan","labour","labor","delivery","baby coming","contraction"],
    a:["Keep the mother calm and comfortable, lying on her left side.","Have clean towels and blankets ready.","Do not pull the baby or cut the cord.","After birth, dry the baby and keep it warm against the mother's skin.","Stay with them until the ambulance arrives."] },
  { t:"Low blood sugar (diabetes)", k:["diabet","sugar","insulin","hypoglyc"],
    a:["If the person is awake and can swallow, give sugar, glucose tablets or sweet juice.","Let them rest and recheck after 10-15 minutes.","If they are drowsy or unconscious, give nothing by mouth.","Put them on their side and wait for the ambulance."] }
];
var aiOpened = false;

function aiAdd(who, html) {
  var d = document.createElement("div");
  d.className = "m " + who; d.innerHTML = (LANG === "hi" && AI_UI[html]) || html;
  $("aiMsgs").appendChild(d);
  $("aiMsgs").scrollTop = $("aiMsgs").scrollHeight;
}
function aiStatus() {
  var act = state.requests.filter(function (r) { return r.status === "Active"; });
  if (!act.length) return "There is no active ambulance trip right now. If you need an ambulance, submit a request under <b>New Request</b>, or call <b>112 / 108</b>.";
  return act.map(function (r) {
    var a = amb(r.ambId), msg;
    if (r.trip === "Dispatched" || r.trip === "En Route")
      msg = "is on the way to <b>" + r.zone + "</b>. Estimated arrival about <b>" + eta(dist(a.zone, r.zone)) + "</b>.";
    else if (r.trip === "On Scene") msg = "has reached the patient at <b>" + r.zone + "</b>.";
    else if (r.trip === "Transporting") msg = "is taking the patient to the hospital.";
    else msg = "has arrived at the hospital.";
    return "🚑 <b>" + r.ambId + "</b> (" + esc(r.name) + ") " + msg + " Status: <b>" + r.trip + "</b>.";
  }).join("<br><br>");
}
function aiReply(text) {
  var q = text.toLowerCase().trim();
  if (/status|\beta\b|where is|how long|when will/.test(q)) return aiStatus();
  var best = null, bestScore = 0;
  AI_KB.forEach(function (e) {
    var sc = 0;
    e.k.concat(AI_HIK[e.t] || []).forEach(function (w) { if (q.indexOf(w) > -1) sc += w.length; });
    if (sc > bestScore) { bestScore = sc; best = e; }
  });
  if (best) {
    var hi = LANG === "hi" && AI_HI[best.t], ti = hi ? hi.t : best.t, st = hi ? hi.a : best.a;
    return "<b>" + ti + "</b><ol>" + st.map(function (x) { return "<li>" + x + "</li>"; }).join("") +
      '</ol><span class="rem">📞 Call 112 / 108 if you have not already. This is basic guidance, not a replacement for medical professionals.</span>';
  }
  if (q.length < 16 && /^(hi|hello|hey|help|namaste)/.test(q)) return "Hello! Tell me what is happening (for example <i>bleeding</i>, <i>burn</i> or <i>not breathing</i>), or tap a topic below.";
  return "I did not understand that. Please tap a topic below or describe the problem in a few words, like <i>chest pain</i> or <i>heavy bleeding</i>. For life-threatening emergencies call <b>112 / 108</b> now.";
}
function sendAI(text) {
  var inp = $("aiInput"), t = text || inp.value.trim();
  if (!t) return;
  aiAdd("me", esc(t)); inp.value = "";
  setTimeout(function () { aiAdd("bot", aiReply(t)); }, 350);
}
function toggleAI() {
  var box = $("aiBox"), open = box.classList.toggle("open");
  $("aiTip").style.display = "none";
  if (open && !aiOpened) {
    aiOpened = true;
    aiAdd("bot", "Hi! I'm the <b>First-Aid Assistant</b> ✚. While the ambulance is on the way, tell me what is happening and I will share simple steps you can follow.");
    var act = state.requests.filter(function (r) { return r.status === "Active"; });
    if (act.length) aiAdd("bot", aiStatus());
    if (open) $("aiInput").focus();
  }
}
(function () {
  var chips = [["❤️ CPR","cpr"],["🩸 Bleeding","bleeding"],["🔥 Burns","burn"],["😮‍💨 Choking","choking"],["🧠 Stroke","stroke"],["⚡ Seizure","seizure"],["🦴 Fracture","fracture"],["🫁 Breathing","breathing difficulty"],["🚑 Ambulance status","ambulance status"]];
  $("aiChips").innerHTML = chips.map(function (c) { return '<span onclick="sendAI(\'' + c[1] + '\')">' + c[0] + "</span>"; }).join("");
})();

// ---------- BACK TO TOP ----------
function toTop() { window.scrollTo({ top: 0, behavior: "smooth" }); }
window.addEventListener("scroll", function () { $("up").className = window.scrollY > 250 ? "on" : ""; });

// ---------- HIDDEN CODE-EXPLANATION PANEL ----------
// [category, name, what it does, where it is used in this website]
var CODE_DOC = [
 ["HTML","<!DOCTYPE html>","Tells the browser this is an HTML5 page.","Very first line of the file."],
