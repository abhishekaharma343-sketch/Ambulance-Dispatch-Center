var codeCat = "All";
function codeRender() {
  var q = $("cq").value.toLowerCase(), cats = ["All", "HTML", "SVG", "CSS", "JavaScript", "Feature → Code"];
  $("ccats").innerHTML = cats.map(function (c) { return '<span class="' + (c === codeCat ? "on" : "") + '" onclick="codeCat=\'' + c + '\';codeRender()">' + c + "</span>"; }).join("");
  var list = CODE_DOC.filter(function (d) { return (codeCat === "All" || d[0] === codeCat) && (d[1] + " " + d[2] + " " + d[3]).toLowerCase().indexOf(q) > -1; });
  $("clist").innerHTML = list.length ? list.map(function (d) {
    return '<div class="cd"><span class="ct">' + d[0] + '</span><span class="nm">' + esc(d[1]) + "</span><div>" + esc(d[2]) + '</div><div class="wh">📍 Used in: ' + esc(d[3]) + "</div></div>";
  }).join("") : '<div class="empty">Nothing found.</div>';
}
function openCode() {
  $("codeBox").classList.add("open");
  $("cbody").classList.remove("open"); $("clk").style.display = "block";
  $("cpin").value = ""; $("cerr").textContent = ""; $("clkIco").textContent = "🔒";
  setTimeout(function () { $("cpin").focus(); }, 50);
}
function checkCode() {
  if ($("cpin").value.trim().toUpperCase() === "ASR") {
    $("clk").style.display = "none"; $("cbody").classList.add("open"); codeRender();
  } else {
    var t = $("cpin").value.trim() ? TEASE[tries++ % TEASE.length] : ["😅", "Kuch to type karo, bhai!"];
    $("clkIco").textContent = t[0]; $("cerr").textContent = t[1]; $("cpin").value = "";
    var b = document.querySelector(".cbox"); b.classList.remove("shake"); void b.offsetWidth; b.classList.add("shake");
  }
}
