  $("yr").textContent = new Date().getFullYear();
  load(); renderPrio(); render();
  try { if (localStorage.getItem("asrLang") === "hi") setLang("hi"); } catch (e) {}
  var th = "light"; try { th = localStorage.getItem("asrTheme") || "light"; } catch (e) {}
  setTheme(th);
})();
