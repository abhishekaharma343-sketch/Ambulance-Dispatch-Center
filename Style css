<style>
  :root {
    --sky: #0ea5e9; --sky2: #38bdf8; --skydark: #0369a1; --skylight: #e0f2fe; --skypale: #f0f9ff;
    --white: #ffffff; --text: #0c4a6e; --muted: #5b7c99; --line: #cfe6f5;
    /* status colours (kept only so priorities and trip stages stay easy to tell apart) */
    --red: #ef4444; --orange: #f97316; --green: #22c55e; --yellow: #eab308; --purple: #8b5cf6; --teal: #14b8a6; --grey: #94a3b8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; font-family: "Segoe UI", Arial, sans-serif; color: var(--text);
    background: linear-gradient(160deg, #bae6fd 0%, #e0f2fe 45%, #ffffff 100%);
    display: flex; justify-content: center; padding: 24px 12px;
  }
  .app { width: 100%; max-width: 1100px; background: var(--white); border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 20px 50px rgba(14,165,233,.25); overflow: hidden; }
  /* header */
  .top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding: 20px 26px; background: linear-gradient(90deg, var(--sky), var(--sky2)); color: #fff; }
  .logo { display: flex; align-items: center; gap: 12px; }
  .logo .ico { font-size: 34px; background: #fff; border-radius: 50%; width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; }
  @keyframes glow { 0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.7); } 50% { box-shadow: 0 0 0 10px rgba(255,255,255,0); } }
  .logo h1 { margin: 0; font-size: 22px; letter-spacing: .5px; }
  .logo small { color: #e0f2fe; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip { background: rgba(255,255,255,.25); border: 1px solid rgba(255,255,255,.5); padding: 6px 12px; border-radius: 20px; font-size: 13px; }
  .chip b { font-size: 15px; }
  /* tabs */
  .tabs { display: flex; gap: 8px; padding: 14px 20px; overflow-x: auto; border-bottom: 1px solid var(--line); background: var(--skypale); }
  .tab { flex: 1; min-width: 130px; border: 1px solid var(--line); background: #fff; color: var(--skydark); padding: 12px 10px; border-radius: 14px; cursor: pointer; font-size: 14px; font-weight: 600; transition: .2s; }
  .tab:hover { background: var(--skylight); transform: translateY(-2px); }
  .tab.active { background: linear-gradient(135deg, var(--sky), var(--sky2)); color: #fff; border-color: transparent; box-shadow: 0 6px 18px rgba(14,165,233,.4); }
  .tab .n { background: #fff; color: var(--skydark); border-radius: 10px; padding: 1px 7px; font-size: 12px; margin-left: 6px; }
  /* panels */
  .panel { display: none; padding: 22px 26px 28px; animation: fade .3s; }
  .panel.show { display: block; }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  h2 { margin: 0 0 16px; font-size: 18px; color: var(--skydark); }
  /* form */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  label { font-size: 12px; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); display: block; }
  input, select, textarea { width: 100%; margin-top: 6px; padding: 11px 12px; border-radius: 10px; border: 1px solid var(--line); background: #fff; color: var(--text); font-size: 14px; outline: none; font-family: inherit; }
  input:focus, select:focus, textarea:focus { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,.25); }
  .prio { display: flex; gap: 8px; margin-top: 6px; }
  .prio div { flex: 1; text-align: center; padding: 10px 4px; border-radius: 10px; border: 2px solid var(--line); background: #fff; cursor: pointer; font-size: 13px; font-weight: 600; transition: .2s; text-transform: none; letter-spacing: 0; color: var(--skydark); }
  .prio div:hover { background: var(--skylight); }
  .prio div.sel { color: #fff; }
  .prio div.sel.Critical { background: var(--red); border-color: var(--red); }
  .prio div.sel.High { background: var(--orange); border-color: var(--orange); }
  .prio div.sel.Medium { background: var(--yellow); border-color: var(--yellow); color: #222; }
  .prio div.sel.Low { background: var(--green); border-color: var(--green); }
  /* buttons */
  button.btn { border: none; cursor: pointer; padding: 11px 18px; border-radius: 10px; color: #fff; font-weight: 600; font-size: 14px; margin: 6px 6px 0 0; transition: .2s; background: var(--skydark); }
  button.btn:hover { transform: translateY(-2px); filter: brightness(1.1); }
  button.btn.main { background: linear-gradient(135deg, var(--sky), var(--sky2)); box-shadow: 0 4px 12px rgba(14,165,233,.4); }
  button.btn.ok { background: var(--sky); }
  button.btn.no { background: #ef4444; }
  button.btn.ghost { background: var(--skylight); color: var(--skydark); }
  button.sm { padding: 7px 12px; font-size: 12px; margin: 2px; }
  /* cards */
  .card { background: var(--skypale); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; margin-bottom: 12px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; border-left: 5px solid var(--sky); }
  .card.Critical { border-left-color: var(--red); } .card.High { border-left-color: var(--orange); }
  .card.Medium { border-left-color: var(--yellow); } .card.Low { border-left-color: var(--green); }
  .card .info { flex: 1; min-width: 220px; } .card .info b { font-size: 16px; }
  .card .info div { color: var(--muted); font-size: 13px; margin-top: 3px; }
  .card .act { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .card .act select { width: auto; max-width: 260px; margin: 0; padding: 8px; font-size: 13px; }
  .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: 700; color: #fff; white-space: nowrap; }
  .Critical.badge { background: var(--red); } .High.badge { background: var(--orange); }
  .Medium.badge { background: var(--yellow); color: #222; } .Low.badge { background: var(--green); }
  .s-Available { background: var(--green); } .s-Dispatched { background: var(--sky); } .s-En-Route { background: var(--purple); }
  .s-On-Scene { background: var(--orange); } .s-Transporting { background: var(--red); } .s-At-Hospital { background: var(--teal); }
  .s-Out-of-Service { background: var(--grey); }
  .steps { display: flex; gap: 4px; margin-top: 8px; width: 100%; }
  .steps i { flex: 1; height: 6px; border-radius: 4px; background: var(--skylight); }
  .steps i.done { background: linear-gradient(90deg, var(--sky), var(--sky2)); }
  /* fleet */
  .fleet { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 18px; }
  .amb { background: var(--skypale); border: 1px solid var(--line); border-radius: 14px; padding: 14px; text-align: center; transition: .2s; }
  .amb:hover { box-shadow: 0 6px 16px rgba(14,165,233,.25); transform: translateY(-3px); }
  .amb .e { font-size: 30px; } .amb b { display: block; margin-top: 4px; } .amb small { color: var(--muted); display: block; margin: 3px 0 8px; }
  .map { width: 100%; background: var(--skypale); border: 1px solid var(--line); border-radius: 14px; }
  /* table */
  .wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; color: var(--skydark); background: var(--skylight); font-size: 12px; text-transform: uppercase; padding: 10px 8px; }
  td { padding: 10px 8px; border-bottom: 1px solid var(--line); }
  .empty { text-align: center; color: var(--muted); padding: 40px 10px; font-size: 15px; }
  /* footer */
  .foot { text-align: center; padding: 18px 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; background: var(--skypale); }
  .foot b { color: var(--text); }
  .foot .members { margin-top: 6px; font-size: 12px; }
  .foot .tag { font-size: 15px; font-weight: 700; color: var(--skydark); margin-bottom: 10px; }
  .foot .hot { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .foot .hot span { background: var(--skylight); border: 1px solid var(--line); padding: 4px 12px; border-radius: 16px; font-size: 12px; color: var(--skydark); }
  .foot .links { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px 18px; margin-bottom: 12px; }
  .foot a { color: var(--sky); text-decoration: none; font-weight: 600; }
  .foot a:hover { text-decoration: underline; }
  .teambtn { background: #fff; color: var(--skydark); border: 1px solid var(--sky); padding: 6px 16px; border-radius: 18px; cursor: pointer; font-size: 12px; font-weight: 600; transition: .2s; }
  .teambtn:hover { background: var(--sky); color: #fff; }
  .team { max-height: 0; overflow: hidden; opacity: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; transition: max-height .4s, opacity .4s, margin .4s; }
  .team.open { max-height: 140px; opacity: 1; margin-top: 10px; }
  .team span { background: linear-gradient(135deg, var(--sky), var(--sky2)); padding: 6px 16px; border-radius: 20px; font-size: 13px; color: #fff; font-weight: 600; display: inline-flex; align-items: baseline; }
  .team span em { font-style: normal; font-size: 30px; font-weight: 900; line-height: 1; margin-right: 1px; color: #fff; text-shadow: 0 2px 6px rgba(3,105,161,.5); }
  .foot .copy { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
  #up { position: fixed; right: 20px; bottom: 20px; width: 44px; height: 44px; border-radius: 50%; border: none; cursor: pointer; font-size: 20px; color: #fff; background: linear-gradient(135deg, var(--sky), var(--sky2)); box-shadow: 0 6px 18px rgba(14,165,233,.5); opacity: 0; pointer-events: none; transition: .3s; z-index: 8; }
  #up.on { opacity: 1; pointer-events: auto; }
  #up:hover { transform: translateY(-3px); }
  /* AI first-aid assistant */
  #aiBtn { position: fixed; right: 20px; bottom: 76px; width: 56px; height: 56px; border-radius: 50%; border: 3px solid #fff; cursor: pointer; font-size: 28px; font-weight: 900; color: #fff; line-height: 1; background: linear-gradient(135deg, var(--sky), var(--skydark)); box-shadow: 0 8px 22px rgba(14,165,233,.6); z-index: 10; transition: .2s; animation: aiPulse 2.2s infinite; }
  #aiBtn:hover { transform: scale(1.1); }
  @keyframes aiPulse { 0%,100% { box-shadow: 0 8px 22px rgba(14,165,233,.6), 0 0 0 0 rgba(14,165,233,.5); } 50% { box-shadow: 0 8px 22px rgba(14,165,233,.6), 0 0 0 14px rgba(14,165,233,0); } }
  #aiBtn .tip { position: absolute; right: 66px; top: 12px; background: #fff; color: var(--skydark); font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 12px; white-space: nowrap; box-shadow: 0 4px 12px rgba(14,165,233,.3); border: 1px solid var(--line); }
  #aiBox { position: fixed; right: 20px; bottom: 144px; width: min(370px, 92vw); height: min(500px, 70vh); background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 16px 50px rgba(3,105,161,.35); display: none; flex-direction: column; overflow: hidden; z-index: 10; }
  #aiBox.open { display: flex; animation: fade .25s; }
  .aiHead { background: linear-gradient(90deg, var(--sky), var(--sky2)); color: #fff; padding: 12px 14px; display: flex; justify-content: space-between; align-items: center; }
  .aiHead b { font-size: 15px; } .aiHead small { display: block; font-size: 11px; color: #e0f2fe; }
  .aiHead button { background: rgba(255,255,255,.25); border: none; color: #fff; width: 28px; height: 28px; border-radius: 50%; cursor: pointer; font-size: 14px; }
  #aiMsgs { flex: 1; overflow-y: auto; padding: 12px; background: var(--skypale); }
  .m { max-width: 88%; padding: 9px 12px; border-radius: 14px; margin-bottom: 9px; font-size: 13px; line-height: 1.45; }
  .m.bot { background: #fff; border: 1px solid var(--line); border-bottom-left-radius: 4px; color: var(--text); }
  .m.me { background: var(--sky); color: #fff; margin-left: auto; border-bottom-right-radius: 4px; }
  .m ol { margin: 6px 0 4px; padding-left: 18px; } .m li { margin-bottom: 3px; }
  .m .rem { display: block; margin-top: 6px; color: #dc2626; font-weight: 700; font-size: 12px; }
  #aiChips { display: flex; gap: 6px; overflow-x: auto; padding: 8px 10px; border-top: 1px solid var(--line); background: #fff; }
  #aiChips span { flex: none; background: var(--skylight); color: var(--skydark); border: 1px solid var(--line); padding: 5px 10px; border-radius: 14px; font-size: 12px; font-weight: 600; cursor: pointer; }
  #aiChips span:hover { background: var(--sky); color: #fff; }
  .aiIn { display: flex; gap: 6px; padding: 8px 10px 10px; background: #fff; }
  .aiIn input { margin: 0; padding: 9px 12px; border-radius: 20px; font-size: 13px; }
  .aiIn button { flex: none; width: 40px; border: none; border-radius: 50%; background: var(--sky); color: #fff; cursor: pointer; font-size: 16px; }
  .langbtn { background: #fff; color: var(--skydark); border: none; border-radius: 20px; padding: 8px 18px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 3px 10px rgba(3,105,161,.3); transition: .2s; }
  .langbtn:hover { transform: translateY(-2px); }
  /* dark mode */
  .map { color: var(--skydark); }
  [data-theme="dark"] {
    color-scheme: dark;
    --white: #0f1b2d; --skypale: #13233a; --skylight: #1b3354; --line: #28435f;
    --text: #e6f1fb; --muted: #8fa9c4; --skydark: #7dd3fc;
  }
  [data-theme="dark"] body { background: linear-gradient(160deg, #060b14 0%, #0b1220 50%, #0a1626 100%); }
  [data-theme="dark"] .app { box-shadow: 0 20px 50px rgba(0,0,0,.6); }
  [data-theme="dark"] .tab:not(.active), [data-theme="dark"] .prio div, [data-theme="dark"] input, [data-theme="dark"] select,
  [data-theme="dark"] textarea, [data-theme="dark"] .teambtn, [data-theme="dark"] #aiBox, [data-theme="dark"] .m.bot,
  [data-theme="dark"] #aiChips, [data-theme="dark"] .aiIn, [data-theme="dark"] #aiBtn .tip { background: var(--white); }
  [data-theme="dark"] .tab:not(.active):hover { background: var(--skylight); }
  [data-theme="dark"] .teambtn:hover { background: var(--sky); color: #fff; }
  [data-theme="dark"] select option { background: #13233a; color: var(--text); }
  [data-theme="dark"] button.btn { background: #0284c7; }
  [data-theme="dark"] button.btn.main { background: linear-gradient(135deg, var(--sky), var(--sky2)); }
  [data-theme="dark"] button.btn.ok { background: var(--sky); }
  [data-theme="dark"] button.btn.no { background: #ef4444; }
  [data-theme="dark"] button.btn.ghost { background: var(--skylight); color: var(--skydark); }
  [data-theme="dark"] .tab .n { background: #fff; color: #0369a1; }
  [data-theme="dark"] #toast { background: #0369a1; }
  [data-theme="dark"] #aiBtn { background: linear-gradient(135deg, var(--sky), #0369a1); border-color: #0f1b2d; }
  /* animated header scene */
  .top { position: relative; min-height: 165px; padding-right: 130px; align-items: flex-start; padding-top: 8px; }
  .top > .logo { position: relative; z-index: 1; }
  .top::after { content: ""; position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 0; pointer-events: none; background: linear-gradient(90deg, rgba(3,105,161,.6) 0%, rgba(3,105,161,0) 42%); }
  .scene { position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .logo h1 { text-shadow: 0 2px 8px rgba(3,105,161,.7); }
  .sc { animation: fadeAll 16s infinite; }
  @keyframes fadeAll { 0% { opacity: 0; } 3%, 94% { opacity: 1; } 98%, 100% { opacity: 0; } }
  .car { animation: carIn 16s infinite; }
  @keyframes carIn { 0% { transform: translateX(520px); } 7%, 100% { transform: translateX(0); } }
  .boom, .hurt, .phone, .b1, .b2, .pm { opacity: 0; }
  .boom { animation: boom 16s infinite; }
  @keyframes boom { 0%, 6% { opacity: 0; } 7% { opacity: 1; } 13%, 100% { opacity: 0; } }
  .hurt { animation: hurt 16s infinite; }
  @keyframes hurt { 0%, 7% { opacity: 0; transform: translateX(0); } 8%, 70% { opacity: 1; transform: translateX(0); } 77%, 78% { opacity: 1; transform: translateX(-57px); } 79%, 100% { opacity: 0; transform: translateX(-57px); } }
  .c { opacity: 0; animation: walk 16s infinite; }
  @keyframes walk { 0%, 8% { opacity: 0; transform: translateX(var(--f)); } 9% { opacity: 1; transform: translateX(var(--f)); } 28%, 100% { opacity: 1; transform: translateX(0); } }
  .bob { animation: bob .45s infinite alternate; }
  @keyframes bob { to { transform: translateY(-1.5px); } }
  .phone { animation: ph 16s infinite; }
  @keyframes ph { 0%, 29% { opacity: 0; } 30%, 56% { opacity: 1; } 57%, 100% { opacity: 0; } }
  .b1 { animation: b1 16s infinite; } .b2 { animation: b2 16s infinite; }
  @keyframes b1 { 0%, 31% { opacity: 0; transform: translateY(6px); } 33%, 44% { opacity: 1; transform: none; } 46%, 100% { opacity: 0; } }
  @keyframes b2 { 0%, 46% { opacity: 0; transform: translateY(6px); } 48%, 60% { opacity: 1; transform: none; } 62%, 100% { opacity: 0; } }
  .ambu { animation: ambGo 16s infinite; transform: translateX(-130px); }
  @keyframes ambGo { 0%, 38% { transform: translateX(-130px); animation-timing-function: ease-out; } 53%, 80% { transform: translateX(320px); animation-timing-function: ease-in; } 96%, 100% { transform: translateX(800px); } }
  .pm { animation: pmGo 16s infinite; }
  @keyframes pmGo { 0%, 59% { opacity: 0; transform: translateX(0); } 60% { opacity: 1; transform: translateX(0); } 67%, 70% { opacity: 1; transform: translateX(50px); } 77%, 78% { opacity: 1; transform: translateX(6px); } 80%, 100% { opacity: 0; transform: translateX(6px); } }
  .lr, .lb { animation: blink .5s infinite; } .lb { animation-delay: .25s; }
  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: .15; } }
  .dash { animation: dash 1s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -26; } }
  /* header menu */
  .hdr-right { position: absolute; top: 14px; right: 18px; z-index: 20; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .menubtn { position: relative; width: 42px; height: 38px; border-radius: 10px; background: rgba(255,255,255,.25); border: 1px solid rgba(255,255,255,.7); cursor: pointer; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 4px; transition: .2s; }
  .menubtn:hover { background: rgba(255,255,255,.4); }
  .menubtn i { display: block; width: 20px; height: 2.5px; background: #fff; border-radius: 2px; transition: .25s; }
  .menubtn.open i:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menubtn.open i:nth-child(2) { opacity: 0; }
  .menubtn.open i:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
  .menubtn:not([data-n="0"])::after { content: attr(data-n); position: absolute; top: -7px; right: -7px; background: #ef4444; color: #fff; font-size: 11px; font-weight: 700; min-width: 18px; height: 18px; line-height: 18px; border-radius: 9px; text-align: center; }
  .minirow { display: flex; flex-direction: column; align-items: flex-end; gap: 5px; }
  .langbtn.mini { padding: 3px 9px; font-size: 11px; min-width: 52px; text-align: center; line-height: 1.3; box-shadow: 0 2px 6px rgba(3,105,161,.3); }
  #chips { display: none; position: absolute; top: calc(100% + 8px); right: 0; flex-direction: column; gap: 8px; background: var(--white); border: 1px solid var(--line); border-radius: 14px; padding: 10px; min-width: 160px; box-shadow: 0 12px 30px rgba(3,105,161,.35); animation: fade .2s; }
  #chips.open { display: flex; }
  #chips .chip { background: var(--skypale); border: 1px solid var(--line); color: var(--text); }
  .logo .ico { flex: none; width: 52px; height: 52px; min-width: 52px; min-height: 52px; font-size: 30px; line-height: 1; position: relative; }
  .logo .ico::after { content: "ASR"; position: absolute; top: -7px; left: 50%; transform: translateX(-50%); background: #ef4444; color: #fff; font-size: 9px; font-weight: 800; letter-spacing: .6px; line-height: 1; padding: 2px 5px; border-radius: 6px; font-family: Arial, sans-serif; text-shadow: none; box-shadow: 0 1px 4px rgba(0,0,0,.3); }
  .logo h1 { display: inline-block; border-bottom: 3px solid #fff; padding-bottom: 3px; }
  .panel h2 { display: inline-block; border-bottom: 1.5px solid var(--sky); padding-bottom: 5px; }
  /* hidden code-explanation panel */
  .secret { width: 12px; height: 12px; min-width: 12px; padding: 0; border: none; border-radius: 50%; background: rgba(14,165,233,.12); cursor: pointer; align-self: center; }
  .secret:hover { background: rgba(14,165,233,.6); }
  #codeBox { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(3,30,60,.65); z-index: 60; align-items: center; justify-content: center; }
  #codeBox.open { display: flex; }
  .cbox { background: var(--white); color: var(--text); width: min(780px, 94vw); max-height: 88vh; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
  .chead { background: linear-gradient(90deg, var(--sky), var(--sky2)); color: #fff; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; }
  .chead b { font-size: 16px; } .chead small { display: block; font-size: 11px; color: #e0f2fe; }
  .chead button { background: rgba(255,255,255,.25); border: none; color: #fff; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; }
  #cq { margin: 10px 14px 0; width: auto; }
  #ccats { display: flex; gap: 6px; flex-wrap: wrap; padding: 8px 14px; }
  #ccats span { background: var(--skylight); color: var(--skydark); border: 1px solid var(--line); padding: 4px 11px; border-radius: 14px; font-size: 12px; font-weight: 600; cursor: pointer; }
